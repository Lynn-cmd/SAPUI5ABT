<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog stretch="true" showHeader="true" id="myLog">
	<Table noDataText="No Log Found" title="Display Log"  growing="true" growingThreshold="20"
	items="{ path : 'to_log', sorter : { path : 'udate', descending : true } }">
            <ColumnListItem vAlign="Middle" highlight="{identify}">
                <cells>
                	<Text text="{objectid}" /> 
                    <Text text="{fldname}" />
                    <Text text="{tfldname}" />
                    <Text text="{f_new}" />
                    <Text text="{f_old}" />
                    <Text text="{keyval}" />
                   <Text text="{path: 'udate', type: 'sap.ui.model.odata.type.DateTime', formatOptions: { pattern: 'YYYY-MM-dd' } }" />
                    <Text text="{path: 'utime', type: 'sap.ui.model.odata.type.Time', formatOptions: { pattern : 'HH:mm:ss'} }" />
                   <Text text="{username}" />
                </cells>
            </ColumnListItem>
            <columns>
            	
            	<Column minScreenWidth="Desktop" demandPopin="true" hAlign="End"  visible = "False">
                    <header>
                        <Text text="{i18n>objectid}" />
                    </header>
                </Column>  
                
                <Column width="10em" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
                    <header>
                        <Text text="{i18n>fldname}" />
                    </header>
                </Column>
                <Column width="10em" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
                    <header>
                        <Text text="{i18n>tfldname}" />
                    </header>
                </Column>
                <Column width="14em" minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <header>
                        <Text text="{i18n>f_new}" />
                    </header>
                </Column>
                <Column  width="14em" minScreenWidth="Desktop" demandPopin="true" hAlign="Center">
                    <header>
                        <Text text="{i18n>f_old}" />
                    </header>
                </Column>
                
                <Column width="20em" hAlign="Begin">
                    <header>
                        <Text text="{i18n>keyval}"   />
                    </header>
                </Column>
                
                 <Column width="8em" hAlign="Begin">
                    <header>
                        <Text text="{i18n>udate}"    />
                    </header>
                </Column>
                
                <Column width="8em" minScreenWidth="Tablet" demandPopin="true" hAlign="Begin">
                    <header>
                        <Text text="{i18n>utime}" />
                    </header>
                </Column>
                
                <Column width="8em" minScreenWidth="Desktop" demandPopin="true" hAlign="Begin">
                    <header>
                        <Text text="{i18n>username}" />
                    </header>
                </Column>
                
            </columns>
        </Table>
        <endButton>
            <Button text="OK" press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>